  "readme": "https://github.com/JoshuaRogers057/cg-session-stats/blob/main/README.md",
  "bugs": "https://github.com/JoshuaRogers057/cg-session-stats/issues",
  "url": "https://github.com/JoshuaRogers057/cg-session-stats",
  "manifest": "https://github.com/JoshuaRogers057/cg-session-stats/releases/latest/download/module.json",
  "download": "https://github.com/JoshuaRogers057/cg-session-stats/releases/download/v0.3.0/module.zip"
}
